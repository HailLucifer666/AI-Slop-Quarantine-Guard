# Web dashboard configuration (Next.js). Copy to `.env.local` and fill in.
# All three are OPTIONAL for local use.

# API base URL. Defaults to http://localhost:8000 if unset — fine for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase auth (OPTIONAL). Leave BOTH blank to run the dashboard with sign-in
# disabled (everything works, just no login gate). Set both to enable OTP +
# Google sign-in — no code changes needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
