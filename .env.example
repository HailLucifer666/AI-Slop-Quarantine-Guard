# API Configuration

# Redis connection (local dev uses default localhost:6379)
REDIS_URL=redis://localhost:6379

# Database URL
# Local/dev (default): SQLite — no setup, file-based.
DATABASE_URL=sqlite:///./app.db
# Production: PostgreSQL. Plain postgresql:// is auto-mapped to the asyncpg driver
# at startup, so either form works. Supabase users: copy the "Connection string"
# (Session/Transaction pooler) from Project Settings → Database.
# DATABASE_URL=postgresql://user:password@db.<ref>.supabase.co:5432/postgres

# GitHub App Configuration
# Get these from your GitHub App registration (Phase 0)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----

# Analyzer kill-switch (comma-separated analyzer IDs to disable)
# Example: SQG001,SQG002
DISABLED_ANALYZERS=

# Environment
ENVIRONMENT=development

# The Crew — advisory AI explainer (Phase 7). OpenAI-compatible endpoint.
# Default is NVIDIA NIM; swap to Claude/OpenAI by changing all three.
# Leave LLM_API_KEY empty to disable the explainer (findings still work).
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=minimaxai/minimax-m3
LLM_API_KEY=
