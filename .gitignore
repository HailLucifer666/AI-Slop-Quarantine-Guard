.env
.env.local
.env.*.local
*.pem

# Local databases — never commit (scan history + settings may hold tokens/keys)
*.db
*.sqlite
*.sqlite3
*.db.bak*
*.bak

__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored to the repo root on purpose. These come from the Python packaging
# template (setuptools build output), but unanchored they also match web/lib/ —
# which is TypeScript SOURCE, not build output. That silently kept the dashboard's
# entire data layer (api.ts, types.ts, useWallData.ts, …) out of version control,
# so a fresh clone could not build the web app.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

.venv
venv/
env/

node_modules/
.next/
out/

.DS_Store
*.log
.setup-stamp

# Local agent tooling / test caches — not project source
.claude/
.benchmarks/
.pytest_cache/

# Local export/snapshot folder (a copy of the tracked tree, not source)
GIT AI SLOP/

# Internal / design / scratch — NOT part of the shipped product (never push)
Dashboard Assets/
CODEBASE_REVIEW_BRIEF.md
PROMPT_improve_detection.md
Dashbaord Design.md.txt
CLAUDE.md
Instructions.md
GIT Dashboard UI.png

# Coverage artifacts (pytest-cov output) — regenerated on every run.
.coverage
coverage.xml
htmlcov/

# Local package cache created by start.bat when the configured PKG_ROOT drive is absent.
.pkgcache/

# TypeScript incremental-build cache — regenerated on every web build, machine-specific.
web/tsconfig.tsbuildinfo

# Local CI-log downloads and kee-preflight artifacts — transient, never source.
.ci-*

# Local ZCode workspace settings (per-machine agent config).
.zcode/

# Local stack launchers — manual run helpers that live outside version control.
run_api.bat
run_web.bat
run_worker.bat

# kee-preflight working trees and reports — transient review tooling, never source.
.worktrees/
.cache/
